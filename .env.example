# =====================================================================
# SOC MULTI-AGENT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in your environment-specific values.
# =====================================================================

# --- 1. LLM Gateway & Model Tiering ---
# Supported modes: auto | omnirouter | openrouter | ollama | deterministic
LLM_PROVIDER_MODE=omnirouter
OMNIROUTER_API_KEY=
OPENROUTER_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1/chat/completions
COPILOT_MODEL=AICODE
OMNIROUTE_MODEL=AICODE

# Model tiering (falls back to OMNIROUTE_FAST_MODEL / OMNIROUTE_REASONING_MODEL / AICODE)
LLM_MODEL_FAST=AICODE
LLM_MODEL_REASONING=AICODE
# OMNIROUTE_FAST_MODEL=
# OMNIROUTE_REASONING_MODEL=

# Local Ollama fallback
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3:latest
OLLAMA_MODEL_FAST=
OLLAMA_MODEL_REASONING=

# Gateway resilience
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# --- 2. Wazuh SIEM & Webhook Receiver ---
# Replace 127.0.0.1 with your Wazuh OVA / host IP in your local `.env`
WAZUH_OVA_IP=127.0.0.1
# Legacy alias supported automatically: WAZUH_MANAGER_IP=
WAZUH_HOST_IP=127.0.0.1
WEBHOOK_PORT=8000
HOST=0.0.0.0

# Comma-separated source IPs or CIDRs allowed to post alerts to the webhook
WAZUH_ALLOWED_IPS=127.0.0.1,localhost
WAZUH_WEBHOOK_SECRET=change-me-strong-secret
WAZUH_MIN_LEVEL=7
MAX_BODY_SIZE=2097152

# --- 3. Threat Intelligence Feeds ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- 4. Orchestration & RAG ---
SOC_ENABLE_PARALLEL_INVESTIGATION=true
RAG_BACKEND=auto
RAG_EMBEDDING_PROVIDER=auto
RAG_EMBEDDING_MODEL=
# Set to 1 to skip loading `.env` automatically
SOC_SKIP_DOTENV=0
