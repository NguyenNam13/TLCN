# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Datasets & large dumps (optional local caches)
data/cache/
*.log
!data/raw/loghub/*.log
data/raw/**/*.zip
data/incidents/*.json

# Coverage & Static Analysis caches
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Build / packaging artifacts
build/
dist/
*.egg-info/

# ChromaDB local state & generated vector caches
chroma_db/
.chroma/
data/chromadb/*.npz
data/chromadb/embedding_cache_*.json

# Evaluation traces & bulky raw result dumps
data/eval/traces/
results/eval/**/raw_results.json
results/eval/latest/
results/eval/smoke_offline/
data/wazuh_alerts/

# Operating system files
.DS_Store
Thumbs.db

# Word temporary lock files
.~*
~$*
