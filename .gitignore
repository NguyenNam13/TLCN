# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Datasets & large dumps (optional local caches)
data/cache/
*.log
!data/raw/loghub/*.log
data/raw/**/*.zip
data/incidents/*.json

# Coverage & Static Analysis caches
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Build / packaging artifacts
build/
dist/
*.egg-info/

# ChromaDB local state
chroma_db/
.chroma/

# Operating system files
.DS_Store
Thumbs.db

# Word temporary lock files
.~*
~$*
